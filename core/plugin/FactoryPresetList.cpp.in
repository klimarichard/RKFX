// Generated by rkfx_add_plugin(): the plugin's compiled-in factory presets.
#include "plugin/FactoryPresets.h"
#include "FactoryPresetData.h"

std::vector<rkfx::FactoryPreset> rkfx::getFactoryPresets()
{
    std::vector<FactoryPreset> list;
    for (int i = 0; i < FactoryPresetData::namedResourceListSize; ++i)
    {
        int size = 0;
        const auto* data = FactoryPresetData::getNamedResource (FactoryPresetData::namedResourceList[i], size);
        list.push_back ({ factoryPresetName (FactoryPresetData::originalFilenames[i]), juce::String::fromUTF8 (data, size) });
    }
    return list;
}
